#usda 1.0
(
    defaultPrim = "Scene"
)

def "Materials"
{
    def Material "CubeMat"
    {
        token outputs:surface.connect = </Materials/CubeMat/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.2, 0.5, 0.8)
            float inputs:metallic = 0.0
            float inputs:roughness = 0.4
            token outputs:surface
        }
    }
}

def Xform "Scene"
{
    # Catmull-Clark cage. With no authored normals and a catmullClark scheme,
    # Flash refines this cube cage into a smooth limit surface via hardware
    # tessellation (a rounded "blob"), not a faceted cube.
    def Mesh "Cube"
    (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Materials/CubeMat>
        color3f[] primvars:displayColor = [(0.2, 0.5, 0.8)]

        point3f[] points = [
            (-0.5, -0.5, -0.5),
            ( 0.5, -0.5, -0.5),
            ( 0.5,  0.5, -0.5),
            (-0.5,  0.5, -0.5),
            (-0.5, -0.5,  0.5),
            ( 0.5, -0.5,  0.5),
            ( 0.5,  0.5,  0.5),
            (-0.5,  0.5,  0.5)
        ]

        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]

        int[] faceVertexIndices = [
            0, 3, 2, 1,
            4, 5, 6, 7,
            0, 4, 7, 3,
            1, 2, 6, 5,
            0, 1, 5, 4,
            3, 7, 6, 2
        ]

        uniform token subdivisionScheme = "catmullClark"
    }
}
