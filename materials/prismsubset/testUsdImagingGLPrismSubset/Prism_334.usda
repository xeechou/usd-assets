#usda 1.0
(
    upAxis = "Y"
)

def "TestMaterial" (
    prepend apiSchemas = ["MaterialBindingAPI"]
    references = @shaderball.usd@
)
{
    over "Scenes"
    {
        over "scene"
        {
            over "Preview_Mesh"
            {
                over "submesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </MaterialX/Materials/BrassOld>
                }
            }

            over "Calibration_Mesh"
            {
                over "submesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                }
            }
        }
    }
}

def Xform "lights"
{
    def DomeLight "DomeLight"
    {
        asset inputs:texture:file = @./StinsonBeach.hdr@
        float xformOp:rotateX:Zup = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:Zup"]
    }
}

def Camera "Camera"
{
    float3 xformOp:rotateYXZ = (-15, 45, 12)
    double3 xformOp:translate = (2150, 1460, 2250)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ"]
}

def Scope "MaterialX" (
    prepend references = @./Prism_334.mtlx@</MaterialX>
)
{
}

