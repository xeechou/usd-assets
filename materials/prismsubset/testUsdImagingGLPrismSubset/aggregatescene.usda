def Xform "objSballRef_ATypeBulbFrosted800lm_0" (
    prepend references = </TestMaterial/Scenes/scene>
)
{
    double3 xformOp:translate = (-2000, 0, 2000)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    over "Preview_Mesh"
    {
        over "submesh" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </MaterialX/Materials/ATypeBulbFrosted800lm>
        }
    }
}

