def Xform "CameraAll"
{
    float3 xformOp:rotateXYZ = (-43.5, 37.3, 0)
    double3 xformOp:translate = (3900, 6300, 5300)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

    def Camera "CameraAll"
    {
        float focalLength = 24
        float focusDistance = 6000
        float horizontalAperture = 36
        float verticalAperture = 24
    }
}

over "TestMaterial"
{
    over "Scenes"
    {
        token visibility = "invisible"
    }
}

