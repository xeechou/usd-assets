<?xml version="1.0"?>
<materialx version="1.38">
   <!-- using standard surface node-->
  <standard_surface name="baskenwoven" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="metalness" type="float" value="0" />
    <input name="base_color" type="color3" output="generic_diffuse_output" nodegraph="baskenwoven_nodegraph" />
    <input name="specular" type="float" value="0" />
    <input name="specular_roughness" type="float" value="1" />
    <input name="specular_IOR" type="float" value="1.5" />
    
    <input name="opacity" type="color3" output="opacity_output" nodegraph="baskenwoven_nodegraph" />
    <input name="normal" type="vector3" output="normal_map_output" nodegraph="baskenwoven_nodegraph" />
    
    <input name="thin_walled" type="boolean" value="false" />
  </standard_surface>
  <surfacematerial name="matbaskenwoven" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="baskenwoven" />
  </surfacematerial>

  <nodegraph name="baskenwoven_nodegraph">
    <adsk:bitmap name="generic_diffuse" type="color3">
      <input name="file" type="filename" value="images/basket_woven_loose.jpg" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.6, 0.6" unit="meter" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="uaddressmode" type="string" value="periodic" />
      <input name="vaddressmode" type="string" value="periodic" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="generic_diffuse_output" type="color3" nodename="generic_diffuse" />
    
    <adsk:bitmap name="opacity" type="color3">
      <input name="file" type="filename" value="images/basket_woven_loose_mask.jpg" colorspace="srgb_texture" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.6, 0.6" unit="meter" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="uaddressmode" type="string" value="periodic" />
      <input name="vaddressmode" type="string" value="periodic" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="rgbamount" type="float" value="1" />
      <input name="invert" type="boolean" value="false" />
    </adsk:bitmap>
    <output name="opacity_output" type="color3" nodename="opacity" />
    <adsk:normal_map name="normal_map" type="vector3">
      <input name="file" type="filename" value="images/basket_woven_loose_normalmap.png" colorspace="lin_rec709" />
      <input name="realworld_offset" type="vector2" value="0, 0" unit="inch" unittype="distance" />
      <input name="realworld_scale" type="vector2" value="0.6, 0.6" unit="meter" unittype="distance" />
      <input name="uv_offset" type="vector2" value="0, 0" />
      <input name="uv_scale" type="vector2" value="1, 1" />
      <input name="uaddressmode" type="string" value="periodic" />
      <input name="vaddressmode" type="string" value="periodic" />
      <input name="rotation_angle" type="float" value="0" />
      <input name="normal_scale" type="float" value="0.3" />
    </adsk:normal_map>
    <output name="normal_map_output" type="vector3" nodename="normal_map" />

  </nodegraph>



</materialx>
