#usda 1.0
(
    doc = "Three overlapping transparent quads for testing WBOIT"
    defaultPrim = "Root"
)

def Xform "Root"
{
    def Camera "FrontCamera"
    {
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # --- Red Quad (back, z = -0.2) ---
    def Mesh "RedQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/RedQuad/RedMaterial>

        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [
            (-2, -2, -0.2),
            ( 2, -2, -0.2),
            ( 2,  2, -0.2),
            (-2,  2, -0.2)
        ]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )

        def Material "RedMaterial"
        {
            token outputs:surface.connect = </Root/RedQuad/RedMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 0)
                float inputs:opacity = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    # --- Green Quad (middle, z = 0.0) ---
    def Mesh "GreenQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/GreenQuad/GreenMaterial>

        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [
            (-1.5, -2.5, 0),
            ( 2.5, -2.5, 0),
            ( 2.5,  1.5, 0),
            (-1.5,  1.5, 0)
        ]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )

        def Material "GreenMaterial"
        {
            token outputs:surface.connect = </Root/GreenQuad/GreenMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 1, 0)
                float inputs:opacity = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    # --- Blue Quad (front, z = 0.2) ---
    def Mesh "BlueQuad" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/BlueQuad/BlueMaterial>

        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [
            (-2.5, -1.5, 0.2),
            ( 1.5, -1.5, 0.2),
            ( 1.5,  2.5, 0.2),
            (-2.5,  2.5, 0.2)
        ]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
            interpolation = "vertex"
        )

        def Material "BlueMaterial"
        {
            token outputs:surface.connect = </Root/BlueQuad/BlueMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 1)
                float inputs:opacity = 0.5
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }
}
