            color3f[] primvars:displayColor = [(1, 0, 0)] (interpolation="constant")
            color3f[] primvars:displayColor = [(1, 0, 1), (1, 1, 0), (1, 1, 0), (1, 0, 2), (1, 1, 0), (0, 1, 1), (0, 1, 0)] (interpolation = "vertex")
        }
    }
    def Scope "Ribbons"{
    }
}
